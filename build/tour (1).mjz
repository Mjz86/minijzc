// MiniJZ tour: loops, branches, short-circuit, optimizer bait.
let s = 0;
let i = 1;
while (i <= 10) {
  if (i % 2 == 0) { s = s + i; } else { s = s + 0; }
  i = i + 1;
}
print s;                    // 30
let x = 3;
print x * x + x * x;        // CSE: x*x computed once -> 18
let d = 0;
if (d != 0 && 100 / d > 1) { print 1; } else { print 2; }  // short-circuit
print (2 + 3) * 4;          // folded to 20
let g = 252;
let h = 105;
while (h != 0) { let r = g % h; g = h; h = r; }
print g;                    // gcd = 21
