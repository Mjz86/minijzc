print x * x + x * x;
let d = 0;
if (d != 0 && 100 / d > 1) { print 1; } else { print 2; }
print (2 + 3) * 4;
let g = 252;
let h = 105;
while (h != 0) { let r = g % h; g = h; h = r; }
print g;
