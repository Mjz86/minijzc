// MiniJZ functions: calls, recursion, mutual recursion (call-graph SCC),
// inlining, and constant-trip-count loop unrolling.

fn add(a, b) { return a + b; }
fn mul(a, b) { return a * b; }

// self-recursive: a 1-node SCC (never inlined)
fn fact(n) {
  if (n <= 1) { return 1; }
  return n * fact(n - 1);
}

// mutually recursive: a 2-node SCC (never inlined)
fn is_even(n) { if (n == 0) { return 1; } return is_odd(n - 1); }
fn is_odd(n)  { if (n == 0) { return 0; } return is_even(n - 1); }

// several returns, condition on a param
fn sign(x) {
  if (x < 0) { return 0 - 1; }
  if (x == 0) { return 0; }
  return 1;
}

// arrays live in the global arena: allocation order follows call order
fn squares_sum(n) {
  let a = array(n);
  let i = 0;
  while (i < n) { a[i] = i * i; i = i + 1; }
  let s = 0;
  i = 0;
  while (i < n) { s = s + a[i]; i = i + 1; }
  return s;
}

// small helpers get INLINED and folded away at compile time
print add(2, 3);              // 5
print mul(add(1, 1), add(2, 2)); // 8
print add(fact(4), 10);       // 34

print fact(6);                // 720
print is_even(10);            // 1
print is_odd(7);              // 1
print is_even(7);             // 0

print sign(0 - 9);            // -1
print sign(0);                // 0
print sign(42);               // 1

print squares_sum(4);         // 14
print squares_sum(5);         // 30

// constant trip count: fully unrolled and folded to a constant
let s = 0;
let i = 0;
while (i < 4) { s = s + i; i = i + 1; }
print s;                      // 6
print i;                      // 4 (the value the loop leaves behind)

// runtime bound from stdin: NOT unrolled, still correct
let n = input();
let t = 0;
i = 0;
while (i < n) { t = t + i * 2; i = i + 1; }
print t;                      // n=5 -> 20
