// guarded-path torture: step 2 (guard needed near B=MAX), i0 < 0,
// trapping body (runtime div), and edge bounds -- the fallback loop must
// run with CORRECT phi entry values in every case.
let n = input();
let s = 0;
let i = 0;
while (i < n) { s = s + i * 2; i = i + 1; }
print s; print i;              // unit step, i0=0: vacuous closed form
let m = input();
let t = 0;
let j = 0;
while (j < m) { t = t + j * 3; j = j + 2; }
print t; print j;              // step 2: guarded closed form
let k = input();
let u = 5;
let p = 0 - 9;
while (p < k) { u = u + p; p = p + 1; }
print u; print p;              // i0 = -9 < 0: guarded closed form
let q = input();
let v = 0;
let w = 0;
while (w < q) { v = v + 100 / (q - w); w = w + 1; }
print v;                       // may-trap body: NO closed form at all
