{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "default (multi-TU, auto compiler)",
      "description": "9 real TUs; clang++ preferred when nothing is pinned",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "gcc",
      "displayName": "g++ (multi-TU)",
      "binaryDir": "${sourceDir}/build-gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "displayName": "clang++ (multi-TU)",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "fancy",
      "displayName": "the full-fat clang++ line (README note)",
      "description": "clang++, C++26, -O3 -g, march=native, the whole -W battery, -fconstexpr-steps — the command line from the README, packaged as a preset",
      "binaryDir": "${sourceDir}/build-fancy",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O3 -g -march=native -fconstexpr-steps=55555555 -Wall -Wextra -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings -Wsign-conversion -Wdelete-non-virtual-dtor -ferror-limit=30",
        "MINIJZ_CXX_STANDARD": "26"
      }
    },
    {
      "name": "header-only",
      "displayName": "single TU (header-only constexpr form)",
      "binaryDir": "${sourceDir}/build-ho",
      "cacheVariables": {
        "MINIJZ_MULTI_CPP": "OFF"
      }
    },
    {
      "name": "fuzz-wide",
      "displayName": "multi-TU + a wide ctest fuzz window",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "FUZZ_SEEDS": "4001:2000",
        "FUZZ_SHARDS": "4",
        "FUZZ_JOBS": "4"
      }
    },
    {
      "name": "windows-llvm",
      "displayName": "Windows: MinGW Makefiles + clang++ (no MSVC needed)",
      "description": "the README Windows recipe: from a plain PowerShell with no Visual Studio environment -- never hits the NMake/nmake trap, CMakeLists.txt intercepts that one early with a friendly message",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-win",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows: Ninja + clang++",
      "description": "same as windows-llvm but with the Ninja generator (needs ninja in PATH; LLVM installs often bundle it)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs-clang",
      "displayName": "Windows: Visual Studio 2022 + the clang-cl toolset",
      "description": "for machines WITH VS installed: the VS generator + clang-cl (all quoted includes are portable now, so the -Wmicrosoft-include noise is gone)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-vs",
      "toolset": {
        "value": "clangcl",
        "strategy": "external"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs-msvc",
      "displayName": "Windows: Visual Studio 2022 + plain MSVC (cl.exe)",
      "description": "the pure-MSVC build: /std:c++20, /utf-8, /constexpr:steps budgets (see CMakeLists.txt); the cx proof checks become object libraries so the generator sets up INCLUDE/LIB for cl",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-msvc",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-gcc",
      "displayName": "Windows: MinGW Makefiles + g++ (MSYS2 / w64devkit)",
      "description": "no LLVM needed: plain MinGW g++; the harness's native parity runner finds it via `where g++`",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-mingw",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "gcc", "configurePreset": "gcc" },
    { "name": "clang", "configurePreset": "clang" },
    { "name": "fancy", "configurePreset": "fancy" },
    { "name": "header-only", "configurePreset": "header-only" },
    { "name": "fuzz-wide", "configurePreset": "fuzz-wide" },
    { "name": "windows-llvm", "configurePreset": "windows-llvm" },
    { "name": "windows-ninja", "configurePreset": "windows-ninja" },
    { "name": "vs-clang", "configurePreset": "vs-clang" },
    { "name": "vs-msvc", "configurePreset": "vs-msvc" },
    { "name": "windows-gcc", "configurePreset": "windows-gcc" }
  ]
}
