// taildup_tour.mjz — the checkpoint-20 feature tour: two tail-duplication
// shapes. (1) The in-loop merge: the body's `if (a > 0)` merge feeds the
// loop header's phi through the post-arm join — the born phi carries the
// value across the re-merge (the loop-latch feedback edge), and the
// second `if` makes the merge's terminator a cbr (the shape that
// survives splice: its arms are single-pred). (2) The fn-tail merge at
// the program's end: `if (a > 0)` sets x per arm and the exit tail
// computes y from x — taildup duplicates the tail into both arms, so each
// arm computes its own y and prints it with no merge block on the path.
// The scripted debugger session below (taildup_debugger_session) arms
// `opt break taildup` and inspects the IR right where the duplication
// happens (twice: the loop merge first, the exit tail second).
let a = input();
let n = input();
let c = 0;
let s = 0;
while (c < n) {
  c = c + 1;
  if (a > 0) { s = s + 1; } else { s = s + 2; }
  if (s > 4) { print s; } else { print s + 100; }
}
print s + c;
let x = 0;
if (a > 0) { x = a + 1; } else { x = a + 2; }
let y = x * 3 + 1;
print y + x;
