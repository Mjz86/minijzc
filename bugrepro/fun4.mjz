fn fun(n) { if (n == 0) { return 0; } if (n%4==1) { return fun1(n/4); } if (n%4==2) { return fun2(n/4); } if (n%4==3) { return fun3(n/4); } return fun(n/4); }
fn fun1(n) { if (n == 0) { return 1; } if (n%4==1) { return fun1(n/4); } if (n%4==2) { return fun2(n/4); } if (n%4==3) { return fun3(n/4); } return fun(n/4); }
fn fun2(n) { if (n == 0) { return 2; } if (n%4==1) { return fun1(n/4); } if (n%4==2) { return fun2(n/4); } if (n%4==3) { return fun3(n/4); } return fun(n/4); }
fn fun3(n) { if (n == 0) { return 3; } if (n%4==1) { return fun1(n/4); } if (n%4==2) { return fun2(n/4); } if (n%4==3) { return fun3(n/4); } return fun(n/4); }
print fun(input());
