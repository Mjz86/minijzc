
fn isn_even(n) { if (n == 0) {  return 0; } return is_odd(n - 1); }
fn isn_odd(n)  { if (n == 0) {  return 1; } return is_even(n - 1); }


print isn_odd(input());



fn is_even(n) { if (n == 0) {  return 0; } return is_odd(n - 1); }
fn is_odd(n)  { if (n == 0) {  return 10; } return is_even(n - 1); }


print is_odd(input());