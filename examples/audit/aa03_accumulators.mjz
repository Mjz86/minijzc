// aa03_accumulators — the deliberate pressure cooker: eight rolling
// accumulators updated in one loop, all read after it. Each iteration
// keeps every accumulator live, so the interference graph must spill —
// the audit exists to see exactly how much.
let a0 = 1; let a1 = 1; let a2 = 1; let a3 = 1;
let a4 = 1; let a5 = 1; let a6 = 1; let a7 = 1;
let i = 0;
while (i < 24) {
  a0 = a0 + a1;
  a1 = a1 + a2;
  a2 = a2 + a3;
  a3 = a3 + a4;
  a4 = a4 + a5;
  a5 = a5 + a6;
  a6 = a6 + a7;
  a7 = a7 + i;
  i = i + 1;
}
print a0 + a1;
print a2 + a3;
print a4 + a5;
print a6 + a7;
